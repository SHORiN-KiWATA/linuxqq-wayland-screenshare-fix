#!/bin/bash
# linuxqq-wayland-fix @VERSION@ —— 修复 Linux QQ 在 Wayland 下的屏幕共享、共享电脑声音、剪贴板和截图闪退。
# https://github.com/SHORiN-KiWATA/linuxqq-wayland-fix
#
#   linuxqq-wayland-fix [QQ 的参数...]   启动 QQ（应用菜单里的「QQ（Wayland修复版）」就是它）
#   linuxqq-wayland-fix --doctor         检查环境与当前 QQ 版本是否兼容
#   linuxqq-wayland-fix --version
#
# 环境变量：
#   QQ_WAYLAND_FIX_QQ         QQ 的启动命令（默认先找 PATH 里的 linuxqq，再找 /opt/QQ/qq）
#   QQ_WAYLAND_FIX_LOG        日志文件（默认 $XDG_RUNTIME_DIR/linuxqq-wayland-fix.log）
#   QQ_WAYLAND_FIX_ANGLE      ANGLE 后端：auto（默认，检测到 Vulkan 时用 vulkan）| vulkan | swiftshader | off
#   QQ_WL_NATIVE_DISABLE=1    关闭屏幕共享修复（排查问题用）
#   QQ_WL_FRAME_REUSE_DISABLE=1 关闭「复用采集纹理」（排查共享时内存增长用）
#   QQ_NVENC=1                屏幕共享改用 NVENC 编 H.264（实验，默认关）
#   QQ_NVENC_ACTIVE=1         配合 QQ_NVENC=1：真正启用 NVENC 编码（默认只挂钩旁观）
#   QQ_CLIPBOARD_FIX_DISABLE=1 关闭剪贴板修复（排查问题用）
#   QQ_CLIPBOARD_FIX_FORCE=1   强制启用剪贴板修复（KDE 上默认禁用，仅供测试）
#   QQ_SCREENSHOT_FIX_DISABLE=1 关闭截图防闪退（排查问题用）
#   QQ_SCREENSHOT_KDE=0       关闭 KDE 的 KWin ScreenShot2 截图路径（排查问题用）
#   QQ_BORDER_FIX_DISABLE=1   关闭窗口修补（共享边框隐藏、截图覆盖层标题与全屏；排查问题用）

set -u

VERSION="@VERSION@"
LIBDIR="@LIBEXECDIR@"
SCREENSHARE_LIB="$LIBDIR/libqq-wl-portal.so"
CLIPBOARD_LIB="$LIBDIR/libqq-clipbridge.so"
SCREENSHOT_LIB="$LIBDIR/libqq-screenshot.so"
BORDERFIX_LIB="$LIBDIR/libqq-borderfix.so"
NVENC_LIB="$LIBDIR/libqq-nvenc.so"
LOG="${QQ_WAYLAND_FIX_LOG:-${XDG_RUNTIME_DIR:-/tmp}/linuxqq-wayland-fix.log}"
QQ_CRASH_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/QQ/crash_files"
CRASH_KEEP="${XDG_CACHE_HOME:-$HOME/.cache}/linuxqq-wayland-fix/crash"

# QQ 崩溃时 Bugly 把调用栈写进 crash_files/tomb_*.txt，但 linuxqq 启动脚本每次都会清空这个目录。
# 启动前把它们复制到缓存目录保存，--doctor 会列出最近的几次。
keep_crash_records() {
    local f
    compgen -G "$QQ_CRASH_DIR/tomb_*.txt" >/dev/null || return 0
    mkdir -p "$CRASH_KEEP" || return 0
    for f in "$QQ_CRASH_DIR"/tomb_*.txt; do
        cp -p "$f" "$CRASH_KEEP/" 2>/dev/null
    done
    ls -1t "$CRASH_KEEP"/tomb_*.txt 2>/dev/null | tail -n +21 | xargs -r rm -f
}

# 优先用 QQ 包自己的 linuxqq 命令（linuxqq 读 qq-flags.conf，linuxqq-appimage 启动 AppImage）。
find_qq() {
    if [[ -n "${QQ_WAYLAND_FIX_QQ:-}" ]]; then
        echo "$QQ_WAYLAND_FIX_QQ"
    elif command -v linuxqq >/dev/null 2>&1; then
        command -v linuxqq
    elif [[ -x /opt/QQ/qq ]]; then
        echo /opt/QQ/qq
    fi
}

# 正在运行的 QQ 主进程（安装版在 /opt/QQ/qq，AppImage 版在挂载目录里，可执行文件都叫 qq）
qq_main_pid() {
    local p cmd
    for p in $(pgrep -f '(^|/)qq( |$)'); do
        cmd=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null) || continue
        [[ "$cmd" == *--type=* ]] && continue
        echo "$p"
        return
    done
}

# 运行中 QQ 主进程的可执行文件；QQ 没运行时退回 /opt/QQ/qq。
# AppImage 版的 exe 在挂载目录里（如 /tmp/.mount_XXXX/.../qq）。
qq_runtime_exe() {
    local p exe
    p=$(qq_main_pid)
    if [[ -n "$p" ]]; then
        exe=$(readlink -f "/proc/$p/exe" 2>/dev/null)
        [[ -n "$exe" && -f "$exe" ]] && { echo "$exe"; return 0; }
    fi
    [[ -x /opt/QQ/qq ]] && echo /opt/QQ/qq
}

# 合成器版本（best-effort，拿不到就空）。
compositor_version() {
    local de="${XDG_CURRENT_DESKTOP:-}"
    case "$de" in
        *niri*) niri --version 2>/dev/null | head -1 | cut -d' ' -f1-2 ;;
        *Hyprland*) hyprctl version 2>/dev/null | head -1 | cut -d' ' -f1-2 ;;
        *KDE*) kwin_wayland --version 2>/dev/null | head -1 ;;
        *GNOME*) gnome-shell --version 2>/dev/null | head -1 ;;
    esac
}

# 已安装包的「名 版本」（best-effort，支持 pacman/dpkg/rpm），查不到输出空。
pkg_installed() {
    local p
    for p in "$@"; do
        if command -v pacman >/dev/null 2>&1 && pacman -Q "$p" >/dev/null 2>&1; then
            pacman -Q "$p" 2>/dev/null
            return
        fi
        if command -v dpkg-query >/dev/null 2>&1 && dpkg-query -W "$p" >/dev/null 2>&1; then
            dpkg-query -W -f='${Package} ${Version}\n' "$p" 2>/dev/null
            return
        fi
        if command -v rpm >/dev/null 2>&1 && rpm -q "$p" >/dev/null 2>&1; then
            rpm -q --qf '%{NAME} %{VERSION}-%{RELEASE}\n' "$p" 2>/dev/null
            return
        fi
    done
}

# 文件所属包「名 版本」（best-effort），查不到输出空。
pkg_own() {
    local f="$1" p
    if command -v pacman >/dev/null 2>&1; then
        p=$(pacman -Qoq "$f" 2>/dev/null | head -1)
        [[ -n "$p" ]] && { pacman -Q "$p" 2>/dev/null; return; }
    fi
    if command -v dpkg-query >/dev/null 2>&1; then
        p=$(dpkg -S "$f" 2>/dev/null | head -1 | cut -d: -f1)
        [[ -n "$p" ]] && { dpkg-query -W -f='${Package} ${Version}\n' "$p" 2>/dev/null; return; }
    fi
    if command -v rpm >/dev/null 2>&1; then
        rpm -qf --qf '%{NAME} %{VERSION}-%{RELEASE}\n' "$f" 2>/dev/null
    fi
}

# 已安装的 QQ：包管理器优先（pacman/dpkg/rpm），查不到再退回可执行文件/AppImage。
qq_installed() {
    local out exe
    out=$(pkg_installed linuxqq linuxqq-appimage linuxqq-nt-bwrap)
    if [[ -z "$out" ]]; then
        exe=$(qq_runtime_exe)
        if [[ -n "$exe" ]]; then
            out="手动安装（$exe）"
        elif compgen -G "/opt/linuxqq-appimage/*.AppImage" >/dev/null; then
            out="linuxqq-appimage（未运行）"
        fi
    fi
    echo "$out"
}

# 当前桌面会选中的 portal 后端配置文件（.portal 的 UseIn 匹配 XDG_CURRENT_DESKTOP）。
portal_backend() {
    local de="${XDG_CURRENT_DESKTOP:-}" f d uses
    [[ -n "$de" ]] || return 0
    for f in /usr/share/xdg-desktop-portal/portals/*.portal; do
        [[ -f "$f" ]] || continue
        uses=$(sed -n 's/^UseIn=//p' "$f" | tr ';' '\n')
        for d in ${de//:/ }; do
            grep -qixF "$d" <<< "$uses" && { echo "$f"; return 0; }
        done
    done
}

# portal 接口版本与可用源（best-effort）：如 "ScreenCast v4（显示器、窗口），Screenshot v2"。
portal_interfaces() {
    command -v busctl >/dev/null 2>&1 || return 0
    local base=org.freedesktop.portal.Desktop obj=/org/freedesktop/portal/desktop
    local sc ss types src="" out=""
    sc=$(busctl --user get-property "$base" "$obj" org.freedesktop.portal.ScreenCast version 2>/dev/null | awk '{print $2}')
    ss=$(busctl --user get-property "$base" "$obj" org.freedesktop.portal.Screenshot version 2>/dev/null | awk '{print $2}')
    types=$(busctl --user get-property "$base" "$obj" org.freedesktop.portal.ScreenCast AvailableSourceTypes 2>/dev/null | awk '{print $2}')
    if [[ "$sc" =~ ^[0-9]+$ ]]; then
        out="ScreenCast v$sc"
        if [[ "$types" =~ ^[0-9]+$ ]]; then
            (( types & 1 )) && src="显示器"
            (( types & 2 )) && src="${src:+$src、}窗口"
            (( types & 4 )) && src="${src:+$src、}虚拟屏"
            out+="（${src:-无可用源}）"
        fi
    fi
    [[ "$ss" =~ ^[0-9]+$ ]] && out+="${out:+，}Screenshot v$ss"
    echo "$out"
}

# QQ 的“安装根”（含 resources/app 的目录）：安装版是 /opt/QQ，AppImage 在挂载目录里。
# 从运行中主进程的 exe 向上找；找不到时退回 AppImage 挂载根/exe 所在目录（find 仍能搜到）。
qq_runtime_dir() {
    local exe d i
    exe=$(qq_runtime_exe) || return 1
    d=$(dirname "$exe")
    for i in 1 2 3 4 5; do
        if [[ -e "$d/resources/app" || -e "$d/broadcast-core.so" ]]; then
            echo "$d"
            return 0
        fi
        [[ "$d" == "/" || -z "$d" ]] && break
        d=$(dirname "$d")
    done
    case "$exe" in
        /tmp/.mount_*) echo "$exe" | cut -d/ -f1-3 ;; # AppImage 挂载根
        *) echo "$(dirname "$exe")" ;;
    esac
}

# 系统里有没有可用的 Vulkan 驱动（ICD 声明）。
vulkan_available() {
    local f
    local env_files="${VK_DRIVER_FILES:-${VK_ICD_FILENAMES:-}}"
    if [[ -n "$env_files" ]]; then
        local IFS=':'
        for f in $env_files; do
            [[ -f "$f" ]] && return 0
        done
    fi
    for f in /usr/share/vulkan/icd.d/*.json /etc/vulkan/icd.d/*.json \
             "${XDG_DATA_HOME:-$HOME/.local/share}/vulkan/icd.d"/*.json; do
        [[ -f "$f" ]] && return 0
    done
    return 1
}

# ANGLE 后端：auto（默认，检测到 Vulkan 就用 vulkan）| vulkan | swiftshader | off。
# 部分设备上 Wayland + ANGLE 的 GLES 后端会把屏幕共享画面渲染花，
# 换用 Vulkan 后端可避开；没有 Vulkan 时可以手动选 swiftshader（软件，慢）。
angle_mode() {
    case "${QQ_WAYLAND_FIX_ANGLE:-auto}" in
        auto)
            if vulkan_available; then echo vulkan; else echo none; fi
            ;;
        vulkan | swiftshader) echo "${QQ_WAYLAND_FIX_ANGLE}" ;;
        off | default | none | "") echo none ;;
        *) echo none ;;
    esac
}

# KDE Plasma 自带 XWayland↔Wayland 剪贴板同步（KWin/Klipper），与我们的桥冲突会让 QQ 崩溃，
# 所以 KDE 上默认不预加载剪贴板修复；QQ_CLIPBOARD_FIX_FORCE=1 可强制启用。
clipboard_auto_disabled() {
    [[ -z "${QQ_CLIPBOARD_FIX_FORCE:-}" ]] || return 1
    [[ "${XDG_CURRENT_DESKTOP:-}" == *KDE* || -n "${KDE_FULL_SESSION:-}" ]]
}

clipboard_state() {
    if clipboard_auto_disabled; then
        echo "off(kde)"
    elif [[ -n "${QQ_CLIPBOARD_FIX_DISABLE:-}" && "${QQ_CLIPBOARD_FIX_DISABLE}" != 0 ]]; then
        echo off
    else
        echo on
    fi
}

# 当前生效的 QQ 版本目录：热更新版本优先，否则用安装目录。
qq_version_dir() {
    local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/QQ/versions" cur=""
    if [[ -f "$cfg/config.json" ]]; then
        cur=$(sed -n 's/.*"curVersion"[^"]*"\([^"]*\)".*/\1/p' "$cfg/config.json" | head -1)
    fi
    if [[ -n "$cur" && -d "$cfg/$cur" ]]; then
        echo "$cfg/$cur"
    elif [[ -d /opt/QQ/resources/app ]]; then
        echo /opt/QQ/resources/app
    fi
}

doctor() {
    local ok=0 warn=0 fail=0
    pass() { printf '  \e[32m✓\e[0m %s\n' "$*"; ok=$((ok + 1)); }
    note() { printf '  \e[33m!\e[0m %s\n' "$*"; warn=$((warn + 1)); }
    bad()  { printf '  \e[31m✗\e[0m %s\n' "$*"; fail=$((fail + 1)); }

    echo "linuxqq-wayland-fix $VERSION 自检"
    echo
    echo "[基础]"
    local qq; qq=$(find_qq)
    [[ -n "$qq" ]] && pass "QQ 启动方式: $qq" || bad "找不到 QQ（linuxqq 或 /opt/QQ/qq），可用 QQ_WAYLAND_FIX_QQ 指定"
    local qqinst; qqinst=$(qq_installed)
    if [[ -n "$qqinst" ]]; then
        pass "QQ 安装: $qqinst"
    else
        note "未检测到已安装的 linuxqq / linuxqq-appimage 包（可能手动安装）"
    fi
    [[ -r "$SCREENSHARE_LIB" ]] && pass "屏幕共享修复: $SCREENSHARE_LIB" || bad "找不到 $SCREENSHARE_LIB"
    if clipboard_auto_disabled; then
        note "剪贴板修复: KDE 默认禁用（Plasma 自带同步，QQ 剪贴板照常可用；QQ_CLIPBOARD_FIX_FORCE=1 强制启用）"
    elif [[ -r "$CLIPBOARD_LIB" ]]; then
        pass "剪贴板修复: $CLIPBOARD_LIB"
    else
        bad "找不到 $CLIPBOARD_LIB"
    fi
    [[ -r "$SCREENSHOT_LIB" ]] && pass "截图防闪退: $SCREENSHOT_LIB" || bad "找不到 $SCREENSHOT_LIB"
    [[ -r "$BORDERFIX_LIB" ]] && pass "窗口修补（共享边框/截图覆盖层）: $BORDERFIX_LIB" || note "找不到 $BORDERFIX_LIB（共享边框会变成窗口、截图覆盖层不平铺）"
    [[ -n "${WAYLAND_DISPLAY:-}" ]] && pass "Wayland 会话: $WAYLAND_DISPLAY" || note "WAYLAND_DISPLAY 为空，不在 Wayland 会话里？"
    [[ -n "${DISPLAY:-}" ]] && pass "XWayland: $DISPLAY" || bad "DISPLAY 为空：QQ 的界面与剪贴板仍需要 XWayland"
    case "$(angle_mode)" in
        vulkan) pass "ANGLE 后端: vulkan（检测到 Vulkan，可规避观看共享花屏）" ;;
        swiftshader) note "ANGLE 后端: swiftshader（软件渲染，较慢，由 QQ_WAYLAND_FIX_ANGLE 指定）" ;;
        none) note "ANGLE 后端: 默认；若观看共享花屏，可设 QQ_WAYLAND_FIX_ANGLE=swiftshader（较慢）或改用 X11，见 docs/原理详解.md#附观看共享花屏" ;;
    esac

    echo
    echo "[QQ 内部实现（QQ 更新后用来判断修复是否还适用）]"
    local vdir rdir bc av wrapper
    vdir=$(qq_version_dir)
    rdir=$(qq_runtime_dir)
    local roots=()
    [[ -n "$vdir" ]] && roots+=("$vdir")
    [[ -n "$rdir" ]] && roots+=("$rdir")
    roots+=(/opt/QQ)
    bc=$(find "${roots[@]}" -name broadcast-core.so -print -quit 2>/dev/null)
    av=$(find "${roots[@]}" -name libAVSDKPlugin.so -print -quit 2>/dev/null)
    local wrapper_candidates=()
    [[ -n "$vdir" ]] && wrapper_candidates+=("$vdir/wrapper.node")
    if [[ -n "$rdir" ]]; then
        wrapper_candidates+=("$rdir/wrapper.node" "$rdir/resources/app/wrapper.node")
    fi
    wrapper_candidates+=(/opt/QQ/resources/app/wrapper.node)
    wrapper=$(ls "${wrapper_candidates[@]}" 2>/dev/null | head -1)
    if [[ -z "$bc" ]]; then
        if [[ -z "$rdir" && -e /opt/linuxqq-appimage ]]; then
            note "找不到 broadcast-core.so：AppImage 需要 QQ 运行中才能检查内部实现（启动 QQ 后再运行 --doctor）"
        else
            bad "找不到 broadcast-core.so（QQ 版本目录: ${vdir:-?}）"
        fi
    else
        grep -aq MonitorCapture_WaylandProc "$bc" \
            && pass "屏幕共享：存在 Wayland 采集线程" \
            || bad "屏幕共享：没有 MonitorCapture_WaylandProc，QQ 改了采集实现"
        grep -aq XDG_SESSION_TYPE "$bc" \
            && pass "屏幕共享：仍用 XDG_SESSION_TYPE 判断 Wayland" \
            || bad "屏幕共享：broadcast-core 不再读 XDG_SESSION_TYPE"
        local f
        for f in pw_context_connect_fd pw_stream_connect pw_core_disconnect pw_stream_dequeue_buffer; do
            grep -aq "$f" "$bc" || bad "屏幕共享：找不到 $f"
        done
        grep -aq pa_context_get_sink_info_by_name "$bc" \
            && pass "共享电脑声音：仍通过 pa_context_get_sink_info_by_name 查询格式" \
            || note "共享电脑声音：查询方式变了，可能无声"
    fi
    # 窗口几何为空时的崩溃检查（见 qq-wl-portal.c「6.」）：特征码必须恰好出现一次
    local qqbin offs
    qqbin=$(qq_runtime_exe)
    if [[ -f "$qqbin" ]]; then
        offs=$(LC_ALL=C grep -obaF $'\x44\x8b\x7e\x08\x45\x85\xff\x74' "$qqbin" 2>/dev/null | cut -d: -f1)
        if [[ "$offs" =~ ^[0-9]+$ ]] &&
           [[ $(od -An -tx1 -j $((offs + 9)) -N 8 "$qqbin" | tr -d ' \n') == 448b660c4585e474 ]]; then
            pass "共享时防闪退：找到窗口几何检查"
        else
            note "共享时防闪退：QQ 改了实现，显示器坐标不从 0 开始时共享可能闪退（issue #1）"
        fi
    fi
    # NVENC 编码器替换（见 qq-nvenc.c）：挂钩点是 CreateH264Encoder 的入口字节，必须唯一且不变
    if [[ -e "$LIBDIR/libqq-nvenc.so" ]]; then
        if [[ -z "$av" ]]; then
            note "NVENC：找不到 libAVSDKPlugin.so，无法检查挂钩点"
        elif [[ $(LC_ALL=C grep -obaF $'\x55\x48\x89\xfd\xbf\x10\x02\x00\x00\x53\x48\x83\xec\x08' "$av" 2>/dev/null | wc -l) == 1 ]]; then
            pass "NVENC：CreateH264Encoder 入口字节与挂钩点一致"
        else
            note "NVENC：libAVSDKPlugin.so 的编码器入口变了，QQ_NVENC=1 会拒绝挂钩并走软件编码"
        fi
    fi
    if [[ -z "$wrapper" ]]; then
        note "找不到 wrapper.node，跳过剪贴板检查"
    elif grep -aq XSetSelectionOwner "$wrapper"; then
        pass "剪贴板：QQ 仍是 X11 实现"
    else
        bad "剪贴板：wrapper.node 不再使用 XSetSelectionOwner，QQ 改了剪贴板实现"
    fi

    echo
    echo "[桌面环境]"
    local de="${XDG_CURRENT_DESKTOP:-}" st="${XDG_SESSION_TYPE:-未知}" cv
    cv=$(compositor_version)
    if [[ -z "$de" ]]; then
        note "桌面环境: 无法识别（XDG_CURRENT_DESKTOP 为空，$st）"
    elif [[ -n "$cv" ]]; then
        pass "桌面环境: $de（$st, $cv）"
    else
        pass "桌面环境: $de（$st）"
    fi
    if command -v busctl >/dev/null 2>&1; then
        local psvc pfile pdbus pown pstate pdesc piface ptypes
        psvc=$(pkg_installed xdg-desktop-portal)
        piface=$(portal_interfaces)
        if [[ -n "$piface" ]]; then
            pfile=$(portal_backend)
            pdesc=""
            if [[ -n "$pfile" ]]; then
                pdbus=$(sed -n 's/^DBusName=\(org\.freedesktop\.impl\.portal\..*\)$/\1/p' "$pfile" | head -1)
                pown=$(pkg_own "$pfile")
                if [[ -n "$pdbus" ]] && busctl --user list 2>/dev/null | grep -F "$pdbus" | grep -q activatable; then
                    pstate="按需启动"
                elif [[ -n "$pdbus" ]] && busctl --user list 2>/dev/null | grep -qF "$pdbus"; then
                    pstate="运行中"
                else
                    pstate="未运行"
                fi
                pdesc="，后端 $(basename "$pfile")（${pown:+$pown，}$pstate）"
                if [[ "$pstate" == "未运行" ]]; then
                    note "Portal: ${psvc:-xdg-desktop-portal} 运行中$pdesc"
                else
                    pass "Portal: ${psvc:-xdg-desktop-portal} 运行中$pdesc"
                fi
            elif [[ -n "${XDG_CURRENT_DESKTOP:-}" ]]; then
                note "Portal: ${psvc:-xdg-desktop-portal} 运行中（未找到匹配「${XDG_CURRENT_DESKTOP}」的后端配置，屏幕共享可能不可用）"
            else
                pass "Portal: ${psvc:-xdg-desktop-portal} 运行中"
            fi
            pass "Portal 接口: $piface"
        else
            bad "Portal: xdg-desktop-portal 不可用（屏幕共享、GNOME 截图修复将无法工作）"
        fi
        ptypes=$(busctl --user get-property org.freedesktop.portal.Desktop /org/freedesktop/portal/desktop \
                org.freedesktop.portal.ScreenCast AvailableSourceTypes 2>/dev/null | awk '{print $2}')
        [[ -n "$ptypes" && "$ptypes" != 0 ]] && pass "屏幕共享：portal 录屏可用" \
            || bad "屏幕共享：xdg-desktop-portal 没有可用的 ScreenCast 实现"
    else
        note "没有 busctl，跳过 portal 检查"
    fi
    if clipboard_auto_disabled; then
        note "剪贴板：KDE Plasma 自带 XWayland 剪贴板同步，本修复已默认禁用（QQ 剪贴板照常可用）"
    elif command -v wayland-info >/dev/null 2>&1; then
        local wi; wi=$(wayland-info 2>/dev/null)
        if grep -q ext_data_control_manager_v1 <<< "$wi"; then
            pass "剪贴板：合成器支持 ext-data-control"
        elif grep -q zwlr_data_control_manager_v1 <<< "$wi"; then
            pass "剪贴板：合成器支持 wlr-data-control"
        else
            bad "剪贴板：合成器不支持 data-control（GNOME 即是如此），剪贴板修复无法工作"
        fi
    else
        note "没有 wayland-info，跳过剪贴板协议检查（安装 wayland-utils 可检查）"
    fi
    # 剪贴板桥靠 libXRes（运行时 dlopen）认出合成器的 X11 剪贴板代理窗口；缺了它会静默退化，
    # 外部复制的内容不再经桥接交给 QQ。NixOS 不用 ld.so.cache，跳过。
    if ! clipboard_auto_disabled && [[ ! -e /etc/NIXOS ]] && command -v ldconfig >/dev/null 2>&1 \
            && ! ldconfig -p 2>/dev/null | grep -q 'libXRes\.so\.1'; then
        bad "剪贴板：缺少 libXRes（Arch: libxres，Debian/Ubuntu: libxres1，Fedora: libXres），认不出合成器的剪贴板代理"
    fi
    if [[ "${XDG_CURRENT_DESKTOP:-}" == *KDE* ]]; then
        local kde_helper="$LIBDIR/qq-screenshot-helper" kde_desktop="" d
        for d in ${XDG_DATA_DIRS:-/usr/local/share:/usr/share} /usr/share; do
            if [[ -r "$d/applications/qq-screenshot-helper.desktop" ]]; then
                kde_desktop="$d/applications/qq-screenshot-helper.desktop"
                break
            fi
        done
        if [[ ! -x "$kde_helper" ]]; then
            note "截图：缺 $kde_helper（KDE 下截图会是黑图，重装本包）"
        elif [[ -z "$kde_desktop" ]]; then
            note "截图：找不到 qq-screenshot-helper.desktop，KWin 的权限检查会拒绝 ScreenShot2（重装本包）"
        elif ! grep -q '^X-KDE-DBUS-Restricted-Interfaces=org\.kde\.KWin\.ScreenShot2$' "$kde_desktop"; then
            note "截图：$kde_desktop 的受限接口声明格式不对（不能带结尾分号），KWin 会拒绝 ScreenShot2"
        elif command -v busctl >/dev/null 2>&1 && ! busctl --user status org.kde.KWin.ScreenShot2 >/dev/null 2>&1; then
            note "截图：找不到 org.kde.KWin.ScreenShot2 服务（KWin 版本过旧？）"
        else
            pass "截图：KDE ScreenShot2（helper + 权限声明）已就绪"
        fi
    fi
    # Easy Effects 的排除名单在 [StreamInputs] / [StreamOutputs] 的 blocklist=（逗号分隔）。
    # 提到 TRAE 但键不是 blocklist 的行（如 exclude=）Easy Effects 不读，单独指出来，免得用户以为配过了。
    local ee res missing wrong
    for ee in "$HOME/.var/app/com.github.wwmm.easyeffects/config/easyeffects/db/easyeffectsrc" \
              "${XDG_CONFIG_HOME:-$HOME/.config}/easyeffects/db/easyeffectsrc"; do
        [[ -f "$ee" ]] || continue
        res=$(awk -F= '
            /^\[/ { sec = $0; next }
            sec != "[StreamInputs]" && sec != "[StreamOutputs]" { next }
            $1 == "blocklist" {
                n = split(substr($0, length($1) + 2), a, ",")
                for (i = 1; i <= n; i++) if (a[i] == "TRAE") ok[sec] = 1
                next
            }
            /TRAE/ { print "wrong " $1 }
            END {
                if (!ok["[StreamInputs]"]) print "missing 输入"
                if (!ok["[StreamOutputs]"]) print "missing 输出"
            }' "$ee")
        wrong=$(awk '$1 == "wrong" { print $2 "=" }' <<<"$res" | sort -u | paste -sd' ')
        missing=$(awk '$1 == "missing" { printf "「%s」", $2 }' <<<"$res")
        if [[ -n "$wrong" ]]; then
            note "Easy Effects 配置里有 $wrong 写着 TRAE，但 Easy Effects 不读这个键，不会生效；排除名单的键是 blocklist=，请在界面里添加，或删掉这些行（$ee）"
        fi
        if [[ -n "$missing" ]]; then
            note "检测到 Easy Effects：请在$missing的排除名单里加上 TRAE，否则 QQ 一开通话/共享就会崩（$ee）"
        else
            pass "Easy Effects 已排除 QQ（TRAE）"
        fi
    done
    if systemctl --user is-active -q linuxqq-clipsync 2>/dev/null || pgrep -f "(^|/)linuxqq-clipsync( |$)" >/dev/null; then
        note "linuxqq-clipsync 正在运行：本工具已包含剪贴板修复，同时运行会重复同步。请停用：systemctl --user disable --now linuxqq-clipsync"
    fi

    echo
    echo "[正在运行的 QQ]"
    local pid
    pid=$(qq_main_pid)
    if [[ -z "$pid" ]]; then
        pass "QQ 未运行"
    elif tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -q 'libqq-wl-portal.so'; then
        pass "QQ（PID $pid）已注入"
    else
        bad "QQ（PID $pid）没有注入：请完全退出 QQ（含托盘），再从「QQ（Wayland修复版）」打开"
    fi

    echo
    echo "[最近的 QQ 崩溃记录]"
    keep_crash_records
    local t
    t=$(ls -1t "$CRASH_KEEP"/tomb_*.txt 2>/dev/null | head -3)
    if [[ -z "$t" ]]; then
        pass "没有崩溃记录"
    else
        while read -r f; do
            note "$(date -r "$f" '+%F %T')  $f"
        done <<< "$t"
    fi

    echo
    echo "通过 $ok，提醒 $warn，失败 $fail。日志：$LOG"
    [[ $fail -eq 0 ]]
}

case "${1:-}" in
    --doctor) doctor; exit $? ;;
    --version) echo "linuxqq-wayland-fix $VERSION"; exit 0 ;;
    --help|-h) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

QQ=$(find_qq)
if [[ -z "$QQ" ]]; then
    echo "linuxqq-wayland-fix: 找不到 QQ（linuxqq 或 /opt/QQ/qq），可用 QQ_WAYLAND_FIX_QQ 指定" >&2
    exit 1
fi

preload=""
for lib in "$SCREENSHARE_LIB" "$CLIPBOARD_LIB" "$SCREENSHOT_LIB" "$BORDERFIX_LIB" "$NVENC_LIB"; do
    [[ "$lib" == "$CLIPBOARD_LIB" ]] && clipboard_auto_disabled && continue
    [[ -r "$lib" ]] && preload="${preload:+$preload:}$lib"
done
export LD_PRELOAD="$preload${LD_PRELOAD:+:$LD_PRELOAD}"

# XDG_SESSION_TYPE=x11：让 QQ 界面与音视频 SDK 不拦截共享；
#   注入库只对 broadcast-core.so 改报 wayland，使它走自带的 portal + PipeWire 路径。
# MESA_SHADER_CACHE_DISABLE：QQ 的 libAVSDKPlugin 导出了自带的 ZSTD_* 符号，
#   会劫持 Mesa 着色器缓存的 zstd 解压，导致采集进程崩溃。
export XDG_SESSION_TYPE=x11
export MESA_SHADER_CACHE_DISABLE="${MESA_SHADER_CACHE_DISABLE:-true}"

angle_arg=()
case "$(angle_mode)" in
    vulkan) angle_arg=(--use-angle=vulkan) ;;
    swiftshader) angle_arg=(--use-angle=swiftshader) ;;
esac

keep_crash_records
{ echo "=== linuxqq-wayland-fix $VERSION $(date '+%F %T') $QQ $* angle=$(angle_mode) clipboard=$(clipboard_state)"; } >"$LOG" 2>/dev/null || LOG=/dev/null
exec "$QQ" --ozone-platform=wayland "${angle_arg[@]}" "$@" >>"$LOG" 2>&1
